# Copy to .env.local (local) and add the same values in Vercel > Settings > Environment Variables.

# Supabase > Project Settings > API
# Plain names on purpose: these are only used on the server, so Vercel can keep them secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this in the browser. Used for user management and the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your live address, used for canonical links, the sitemap and structured data
SITE_URL=https://eportal.pk

# Only read by `npm run seed`: the first admin login to create
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Optional: Adobe Fonts project id for roc-grotesk
# NEXT_PUBLIC_TYPEKIT_ID=
